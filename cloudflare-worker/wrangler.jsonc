{
  // ⚠️ ይህ ስም ነባሩን "halalelectronics" Worker ይተካዋል (update ያደርገዋል)።
  //    ሌሎቹ ሁለት Worker (halal-electronics-api, halal-sms-worker) ከዚህ በኋላ
  //    አያስፈልጉም — ከሠራ በኋላ ከ Dashboard ላይ አጥፋቸው።
  "name": "halalelectronics",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------
  // KV — የአድሚን ይለፍ ቃል hash እና rate-limit counters እዚህ ይቀመጣሉ።
  // id ን ከዚህ ትዕዛዝ ውጤት ውሰድ፦
  //   npx wrangler kv namespace create HALAL_KV
  // ---------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "HALAL_KV",
      "id": "5695a07510944aa5b29f27a370dd2f44"
    }
  ],

  // ---------------------------------------------------------------
  // ምስጢር ያልሆኑ ተለዋዋጮች (secrets እዚህ አታስቀምጥ!)
  // ---------------------------------------------------------------
  "vars": {
    "TELEGRAM_CHAT_ID_1": "6853753240",
    "TELEGRAM_CHAT_ID_2": "713007386",
    "AFROMESSAGE_SENDER_NAME": "",
    // CORS allowlist። ባዶ ቢሆን ሁሉም origin ይፈቀዳል።
    "ALLOWED_ORIGINS": "https://halalelectronicshalal.github.io"
  }

  // ---------------------------------------------------------------
  // Secrets — በ CLI ብቻ (በዚህ ፋይል ውስጥ ፈጽሞ አትጻፍ)፦
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN_1
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN_2
  //   npx wrangler secret put AFROMESSAGE_TOKEN
  //   npx wrangler secret put AFROMESSAGE_IDENTIFIER_ID
  //   npx wrangler secret put ADMIN_MASTER_PASSWORD
  //   npx wrangler secret put FINANCE_PASSWORD
  // ---------------------------------------------------------------
}
